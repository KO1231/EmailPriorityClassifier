# Secrets only. Everything else lives in config.yml, which is meant to be
# readable and diffable.
#
# Not loaded automatically — there is no python-dotenv. Use:
#   uv run --env-file .env epc run

# --- backend: openai -------------------------------------------------------
# A key scoped to api.responses.write and api.responses.read is sufficient;
# the broader model.request scope is not needed.
OPENAI_API_KEY=sk-...

# --- backend: bedrock ------------------------------------------------------
# Uses the usual AWS credential resolution (profile, instance role, env). Set
# these only if you are not using a profile or a role.
# AWS_PROFILE=...
# AWS_REGION=ap-northeast-1

# --- backend: local --------------------------------------------------------
# No credential needed. The server address is llm.base_url in config.yml, not
# an environment variable, so the same container image can point at a server
# outside itself.

# --- Any setting can be overridden from the environment --------------------
# EPC__ prefix, __ between levels. Useful for one-off runs and for schedulers.
# EPC__GMAIL__MAX_THREADS=50
# EPC__RUN__DRY_RUN=true
