# EmailPriorityClassifier configuration.
#
# Policy only — no secrets. API keys and OAuth tokens come from the environment
# or a credential backend, so this file can be read, diffed and reviewed freely.
#
# Any value here can be overridden by an EPC__-prefixed environment variable,
# with __ between levels: EPC__GMAIL__MAX_THREADS=50 overrides gmail.max_threads.
# Precedence, highest first: command line > environment > this file > defaults.
#
# Unknown keys are an error rather than being ignored, so a typo fails loudly.

# The three Gmail labels this tool writes. Display names only: the internal
# Label_... IDs are resolved from the mailbox at startup, so there is nothing to
# keep in sync by hand. `epc labels` shows what they resolve to.
labels:
  p1: "#/P1"
  p2: "#/P2"
  p3: "#/P3"
  create_if_missing: false

gmail:
  query: "in:inbox"
  # Appended to `query`. The single largest cost lever available — it stops
  # every run re-reading the whole inbox.
  extra_query: "newer_than:14d -in:chats"
  max_threads: 1500
  # Resume from a stored historyId when one exists, instead of a full scan.
  incremental: true

credentials:
  backend: local # local | ssm | secrets_manager | service_account
  token_file: secrets/token.json
  client_secrets_file: secrets/client_secrets.json
  # Required for the ssm and secrets_manager backends: the parameter path or
  # secret name holding the durable half of the credentials.
  # parameter_name: /epc/prod/gmail-credentials

llm:
  backend: openai # openai | bedrock | local
  model: gpt-5-mini

  # backend: local — an OpenAI-compatible server (LM Studio, llama.cpp, vLLM).
  # Nothing leaves the machine. Not hardcoded to localhost, so the same image
  # can reach a server outside its own container.
  # base_url: http://host.docker.internal:1234/v1

  # backend: bedrock — Converse is provider-agnostic, so `model` can name any
  # Bedrock model, not only Anthropic's. Region falls back to the usual AWS
  # resolution when unset.
  # region: ap-northeast-1

  concurrency: 15
  requests_per_min: 120
  budget:
    thread_tokens: 4000
    message_chars: 2000

# What happens to a thread once its priority is known. These rules live here
# rather than in the prompt because this is the half of the decision that must
# not be negotiable: a mail that talks its way to P1 still cannot talk its way
# into being starred. The first matching rule wins.
actions:
  rules:
    - when: { priority: P1 }
      unless: { any_label: [SPAM, TRASH] } # a P1 verdict on filtered mail stays quiet
      do: [add_star, move_to_primary, mark_important]
    - when: { priority: P2 }
      do: [move_to_primary]
  # Which tabs move_to_primary will leave. Gmail treats the absence of a
  # category label as Primary, so moving a thread means removing one.
  move_targets: [CATEGORY_PROMOTIONS, CATEGORY_SOCIAL, CATEGORY_UPDATES, CATEGORY_FORUMS]
  # Verbs that take a thread out of the inbox (archive). Off unless asked for.
  allow_destructive: false

dispatch:
  sink: direct # direct | jsonl
  jsonl_path: log/mutations.jsonl
  # Threads buffered before a write. batchModify takes 1000 message IDs per
  # call, which is what turns 1500 round trips into two.
  batch_size: 1000

security:
  # What to do with a thread whose content trips the injection heuristics.
  # downgrade_and_flag records the signal and withholds the high-privilege
  # actions (starring, moving to Primary) from that thread.
  on_suspected_injection: downgrade_and_flag # ignore | flag | downgrade_and_flag

run:
  dry_run: false
  state_backend: local # local | ssm | s3

# `actions` and `dispatch` arrive with the action planner and the mutation
# sinks. They are deliberately absent rather than stubbed: a config schema is
# the expensive thing to change afterwards, so it is written once its consumer
# exists.
